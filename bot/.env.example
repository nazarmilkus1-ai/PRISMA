# Required Telegram credentials
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Required Supabase server credentials
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Canonical server-only Supabase credential.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Legacy alias accepted by the bot for compatibility with older Render setups.
# SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional public site and Minecraft connection details
SITE_URL=https://prisma-fawn-seven.vercel.app
# Same aliases as the website are accepted: NEXT_PUBLIC_JAVA_ADDRESS / NEXT_PUBLIC_BEDROCK_ADDRESS.
MINECRAFT_HOST=
MINECRAFT_JAVA_ADDRESS=
MINECRAFT_JAVA_PORT=25575
MINECRAFT_BEDROCK_ADDRESS=
MINECRAFT_BEDROCK_PORT=18591

# Optional admin identity, panel URL and logs
PANEL_URL=https://your-prisma-domain.example/admin
OWNER_TG_ID=123456789
ADMIN_GROUP_ID=-1001234567890
MODERATION_GROUP_ID=-1003727618185
LOG_LEVEL=INFO

# Optional Redis FSM storage. Use redis:// or rediss://, not an HTTPS REST URL.
REDIS_URL=rediss://default:PASSWORD@YOUR_REDIS_HOST:6379

# Optional Minecraft integration
PLUGIN_API_URL=
PLUGIN_API_KEY=

# Optional Sentry error reporting. Leave empty to keep Sentry disabled.
SENTRY_DSN=

# Render runs the canonical long-lived polling/worker process.
PRISMA_ENV=development
