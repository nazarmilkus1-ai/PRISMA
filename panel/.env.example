NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Legacy alternative for older configurations:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
NEXT_PUBLIC_BOT_USERNAME=your_bot_username_without_at
NEXT_PUBLIC_SITE_URL=https://your-site.example.com
ADMIN_TELEGRAM_IDS=123456789
ADMIN_EMAILS=admin@example.com
# Telegram invite links are generated by the bot notification worker; keep BOT_TOKEN in the bot runtime only.
NOTIFY_FUNCTION_SECRET=CHANGE_ME

# Optional: enables Sentry error/performance reporting when configured.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
