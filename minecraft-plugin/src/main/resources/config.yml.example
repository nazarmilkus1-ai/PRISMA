supabase:
  url: "https://YOUR_PROJECT.supabase.co"
  service-role-key: "YOUR_SUPABASE_SERVICE_ROLE_KEY"

moderation-poll-interval-seconds: 10
http-timeout-seconds: 8
auth-timeout-seconds: 120

# PRISMA_AI в игре: /ai <вопрос>. Оставьте url пустым, чтобы выключить команду.
ai:
  url: ""   # например https://<сайт>/api/ai/ask
  key: ""   # необязательно: общий ключ, должен совпадать с AI_PLUGIN_KEY на сайте
